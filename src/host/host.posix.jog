// POSIX bodies for src.host. Loaded for linux and macos.
// mkdir goes through jogrt_mkdir because mode_t differs between the two.

import std.c
import std.fs
import std.mem
import std.os
import std.strbuilder

private fn fill(path: str, dest: *u8): bool {
    if path.len == 0 || path.len >= 4096 {
        return false
    }
    c.memcpy(dest as *void, path.ptr as *const void, path.len)
    dest[path.len] = 0
    return true
}

actual fn path_sep(): u8 {
    return ':' as u8
}

actual fn compiler_file(): str {
    return "jog"
}

actual fn windows(): bool {
    return false
}

actual fn fold_case(): bool {
    return false
}

actual fn mkdir(path: str): bool {
    var buf: [4096]u8
    if !fill(path, buf[..].ptr) {
        return false
    }
    return c.jogrt_mkdir(buf[..].ptr as *const c.char) == 0
}

actual fn remove_file(path: str) {
    var buf: [4096]u8
    if !fill(path, buf[..].ptr) {
        return
    }
    c.unlink(buf[..].ptr as *const c.char)
}

actual fn remove_dir(path: str) {
    var buf: [4096]u8
    if !fill(path, buf[..].ptr) {
        return
    }
    c.rmdir(buf[..].ptr as *const c.char)
}

actual fn cache_dir(): str with (a: mem.Allocator) {
    var (xdg, ok) = os.env("XDG_CACHE_HOME")
    if ok && xdg.len > 0 {
        val copy = fs.copy_str(xdg)
        val root = fs.join(copy, "jog")
        fs.free_str(copy)
        return root
    }
    var (home, hok) = os.env("HOME")
    if !hok || home.len == 0 {
        return ""
    }
    val copy = fs.copy_str(home)
    val cache = fs.join(copy, ".cache")
    val root = fs.join(cache, "jog")
    fs.free_str(copy)
    fs.free_str(cache)
    return root
}

actual fn prepend_loader_dirs(dirs: []str) with (a: mem.Allocator) {
    if dirs.len == 0 {
        return
    }
    var name: str = "LD_LIBRARY_PATH"
    if os_name() == "macos" {
        name = "DYLD_LIBRARY_PATH"
    }
    var buf = strbuilder.empty()
    var i: usize = 0
    for i < dirs.len {
        if dirs[i].len == 0 {
            i = i + 1
            continue
        }
        if buf.len > 0 {
            buf.append_byte(':' as u8)
        }
        buf.append(dirs[i])
        i = i + 1
    }
    if buf.len == 0 {
        buf.free()
        return
    }
    var (cur, ok) = os.env(name)
    if ok && cur.len > 0 {
        buf.append_byte(':' as u8)
        buf.append(cur)
    }
    var name_c: [64]u8
    var val_c: [8192]u8
    if name.len >= 64 || buf.len >= 8192 {
        buf.free()
        return
    }
    c.memcpy(name_c[..].ptr as *void, name.ptr as *const void, name.len)
    name_c[name.len] = 0
    val text = buf.str()
    c.memcpy(val_c[..].ptr as *void, text.ptr as *const void, text.len)
    val_c[text.len] = 0
    _ = c.setenv(name_c[..].ptr as *const c.char, val_c[..].ptr as *const c.char, 1)
    buf.free()
}
