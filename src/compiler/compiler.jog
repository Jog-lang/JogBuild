// Package src.compiler: finding jog, building its command line, and
// running it. One --module <name>=<dir> per dependency, in resolution
// order. The root folder is the package argument: proc.run has no
// working directory.
//
// proc.run waits and captures both streams. A failed start is an error.
// run_jog prints stdout, then stderr, and returns the child's code,
// including a non-zero exit. See Friction.md, "proc.run waits".

import std.error as errors
import std.fs
import std.io
import std.list
import std.mem
import std.os
import std.proc
import std.strbuilder
import std.text

import src.fail
import src.host
import src.manifest
import src.resolve

/**
 * Split src on one byte. The pieces are views into src, including an
 * empty piece when the separator is at either end. Only the list buffer
 * is allocated.
 * @param src PATH text, not copied
 * @param sep separator byte
 * @context a allocator for the list buffer
 * @return the pieces
 */
private fn split(src: str, sep: u8): list.List<str> with (a: mem.Allocator) {
    var parts: list.List<str>
    var start: usize = 0
    var i: usize = 0
    for i < src.len {
        if src.ptr[i] == sep {
            parts.push(text.slice(src, start, i))
            start = i + 1
        }
        i = i + 1
    }
    parts.push(text.slice(src, start, src.len))
    return parts
}

/**
 * The compiler executable. JOG wins when it is set, without checking
 * that the file is there. Otherwise the first jog on PATH. The file
 * name and the PATH separator come from src.host.
 * fs.exists is true for a directory of that name too. version then
 * returns the process error.
 * @context a allocator for the path
 * @return the path, or ErrNotFound when PATH has no match
 */
fn find(): (str, error?) with (a: mem.Allocator) {
    var (jog_env, jok) = os.env("JOG")
    if jok && jog_env.len > 0 {
        return fs.copy_str(jog_env), null
    }
    var (path_env, pok) = os.env("PATH")
    if !pok || path_env.len == 0 {
        return "", errors.ErrNotFound
    }
    val path = fs.copy_str(path_env)
    defer fs.free_str(path)
    var parts = split(path, host.path_sep())
    defer parts.free()
    var found: str = ""
    for dir in parts.items() {
        if dir.len > 0 && found.len == 0 {
            val candidate = fs.join(dir, host.compiler_file())
            if fs.exists(candidate) {
                found = candidate
            } else {
                fs.free_str(candidate)
            }
        }
    }
    if found.len == 0 {
        return "", errors.ErrNotFound
    }
    return found, null
}

fn module_arg(name: str, dir: str): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append(name)
    b.append("=")
    b.append(dir)
    val text = fs.copy_str(b.str())
    b.free()
    return text
}

/**
 * --module pairs for the compiler. When include_test is false, skips
 * nodes that were required only via require.test.
 */
fn module_flags(g: resolve.Graph, include_test: bool): list.List<str> with (a: mem.Allocator) {
    var flags: list.List<str>
    var i: usize = 0
    for i < g.nodes.len {
        val n = g.nodes.get(i)
        if !include_test && n.is_test {
            i = i + 1
            continue
        }
        flags.push("--module")
        flags.push(module_arg(n.name, n.dir))
        i = i + 1
    }
    return flags
}

private fn libdir_applies(target: str, host_os: str, wasm: bool): bool {
    if target.len == 0 {
        return true
    }
    if wasm {
        return false
    }
    return target == host_os
}

private fn push_libdirs(flags: *list.List<str>, dirs: list.List<manifest.Libdir>, base_dir: str, host_os: str, wasm: bool) with (a: mem.Allocator) {
    var i: usize = 0
    for i < dirs.len {
        val d = dirs.get(i)
        if libdir_applies(d.target, host_os, wasm) {
            flags.push("--libdir")
            flags.push(resolve.absolute(base_dir, d.path))
        }
        i = i + 1
    }
}

private fn split_env_libdirs(src: str): list.List<str> with (a: mem.Allocator) {
    return split(src, host.path_sep())
}

/**
 * Merged --libdir pairs: root jog.mod, each mapped module (respecting
 * include_test), optional jog.local.mod next to the root, JOG_LIBDIRS,
 * then CLI --libdir values. Relative paths are resolved against the
 * owning module directory (or left as given for CLI/env absolutes).
 */
fn libdir_flags(g: resolve.Graph, include_test: bool, cli_dirs: []str, wasm_target: bool): list.List<str> with (a: mem.Allocator) {
    var flags: list.List<str>
    val host_os = host.os_name()
    push_libdirs(&flags, g.root.libdirs, g.root_dir, host_os, wasm_target)
    var i: usize = 0
    for i < g.nodes.len {
        val n = g.nodes.get(i)
        if !include_test && n.is_test {
            i = i + 1
            continue
        }
        push_libdirs(&flags, n.libdirs, n.dir, host_os, wasm_target)
        i = i + 1
    }
    val local_path = fs.join(g.root_dir, "jog.local.mod")
    var (local_data, local_err) = fs.read_all(local_path)
    if local_err == null {
        val body: str = local_data
        var (dirs, err, ok) = manifest.parse_local_overlay(body)
        a.free(local_data)
        if ok {
            push_libdirs(&flags, dirs, g.root_dir, host_os, wasm_target)
            manifest.free_libdirs(&dirs)
        } else {
            var b = strbuilder.empty()
            b.append(local_path)
            b.append(":")
            b.append_int(err.pos.line, 10)
            b.append(":")
            b.append_int(err.pos.col, 10)
            b.append(": error: ")
            b.append(err.message)
            io.eprintln(b.str())
            b.free()
            manifest.free_libdirs(&dirs)
        }
    }
    fs.free_str(local_path)
    var (env_val, env_ok) = os.env("JOG_LIBDIRS")
    if env_ok && env_val.len > 0 {
        var parts = split_env_libdirs(env_val)
        var p: usize = 0
        for p < parts.len {
            if parts.get(p).len > 0 {
                flags.push("--libdir")
                flags.push(fs.copy_str(parts.get(p)))
            }
            p = p + 1
        }
        parts.free()
    }
    i = 0
    for i < cli_dirs.len {
        if cli_dirs[i].len > 0 {
            flags.push("--libdir")
            flags.push(fs.copy_str(cli_dirs[i]))
        }
        i = i + 1
    }
    return flags
}

// flags is the --module / --libdir pairs. extra is the remaining jog flags.
fn command(jog: str, sub: str, root: str, flags: []str, extra: []str): list.List<str> with (a: mem.Allocator) {
    var argv: list.List<str>
    argv.push(jog)
    argv.push(sub)
    argv.push(root)
    var i: usize = 0
    for i < flags.len {
        argv.push(flags[i])
        i = i + 1
    }
    i = 0
    for i < extra.len {
        argv.push(extra[i])
        i = i + 1
    }
    return argv
}

fn run_jog(args: []str): i32 with (a: mem.Allocator) {
    var (out, err) = proc.run(args)
    defer proc.free_output(out)
    if err != null {
        io.eprintln("jog-build: cannot run the compiler")
        return 1
    }
    val out_text: str = out.stdout
    val err_text: str = out.stderr
    io.print(out_text)
    io.eprint(err_text)
    return out.code
}

private fn version_word(src: str): str {
    var i: usize = 0
    for i < src.len {
        val c = src.ptr[i]
        if c != ' ' as u8 && c != '\t' as u8 && c != '\n' as u8 && c != '\r' as u8 {
            break
        }
        i = i + 1
    }
    for i < src.len {
        val c = src.ptr[i]
        if c == ' ' as u8 || c == '\t' as u8 || c == '\n' as u8 || c == '\r' as u8 {
            break
        }
        i = i + 1
    }
    for i < src.len {
        val c = src.ptr[i]
        if c != ' ' as u8 && c != '\t' as u8 && c != '\n' as u8 && c != '\r' as u8 {
            break
        }
        i = i + 1
    }
    val start = i
    for i < src.len {
        val c = src.ptr[i]
        if c == ' ' as u8 || c == '\t' as u8 || c == '\n' as u8 || c == '\r' as u8 {
            break
        }
        i = i + 1
    }
    return text.slice(src, start, i)
}

/**
 * Run `jog version` and parse MAJOR.MINOR.PATCH.
 * @param jog compiler path from find
 * @context a allocator for the version strings
 * @return the version, the process error, or ErrReported when the word is not a version
 */
fn version(jog: str): (manifest.Version, error?) with (a: mem.Allocator) {
    var args: list.List<str>
    defer args.free()
    args.push(jog)
    args.push("version")
    var (out, err) = proc.run(args.items())
    defer proc.free_output(out)
    var blank: manifest.Version
    if err != null {
        return blank, err
    }
    val stdout_text: str = out.stdout
    val word = version_word(stdout_text)
    var (v, ok) = manifest.parse_version(word)
    if !ok {
        return blank, fail.ErrReported
    }
    return manifest.copy_version(v), null
}
