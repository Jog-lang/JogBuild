// Package src.hash: SHA-256 and the content hash. std has no hash beyond
// map.fnv1a, so SHA-256 is written here, from FIPS 180-4 (see
// notes/Reading.md). Milestone 7 of notes/Plan.md.
//
// SHA-256 works on 32-bit words with wrapping addition and rotations.
// Jog integer arithmetic panics on overflow and has no wrapping add yet
// (CTools Friction.md, "no wrappingMul"), so add in u64 and mask with
// 0xFFFFFFFF, as map.fnv1a does for its multiply. A runtime u32 left
// shift truncates, but a constant shift that does not fit is a compile
// error (Friction.md, "u32 left shift truncates at run time"), so the
// left half of each rotation is also a u64 shift masked back to 32 bits.
// Ch uses e ^ 0xFFFFFFFF rather than ~e, because a constant ~0 does not
// fit in u32.
//
// The content hash is notes/Packages.md, "Content hash": for every file
// under src/, sorted by name in byte order, one line of
// "<lowercase hex sha256 of the bytes> <name>\n"; the hash is "sha256:"
// and the lowercase hex SHA-256 of all those lines. content_hash does
// not sort; the caller passes files in that order.

import std.mem
import std.strbuilder

struct Sha256 {
    h: [8]u32
    buf: [64]u8
    buf_len: usize
    total: u64
}

struct File {
    name: str
    data: bytes
}

// First 64 SHA-256 constants, FIPS 180-4 section 4.2.2.
val sha_k: [64]u32 = [64]u32(
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
)

fn sha256_new(): Sha256 {
    var s = Sha256()
    s.h[0] = 0x6a09e667
    s.h[1] = 0xbb67ae85
    s.h[2] = 0x3c6ef372
    s.h[3] = 0xa54ff53a
    s.h[4] = 0x510e527f
    s.h[5] = 0x9b05688c
    s.h[6] = 0x1f83d9ab
    s.h[7] = 0x5be0cd19
    return s
}

private fn add_u32(x: u32, y: u32): u32 {
    return (((x as u64) + (y as u64)) & 0xFFFFFFFF) as u32
}

private fn add4(a: u32, b: u32, c: u32, d: u32): u32 {
    val sum = (a as u64) + (b as u64) + (c as u64) + (d as u64)
    return (sum & 0xFFFFFFFF) as u32
}

private fn add5(a: u32, b: u32, c: u32, d: u32, e: u32): u32 {
    val sum = (a as u64) + (b as u64) + (c as u64) + (d as u64) + (e as u64)
    return (sum & 0xFFFFFFFF) as u32
}

// Rotate x right by n bits. n is 1..31. The left shift is done in u64.
private fn rotr(x: u32, n: u64): u32 {
    val v = x as u64
    val left = (v << (32 - n)) & 0xFFFFFFFF
    val right = v >> n
    return (left | right) as u32
}

private fn shr32(x: u32, n: u64): u32 {
    return ((x as u64) >> n) as u32
}

private fn sigma0(x: u32): u32 {
    return rotr(x, 7) ^ rotr(x, 18) ^ shr32(x, 3)
}

private fn sigma1(x: u32): u32 {
    return rotr(x, 17) ^ rotr(x, 19) ^ shr32(x, 10)
}

private fn big0(x: u32): u32 {
    return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22)
}

private fn big1(x: u32): u32 {
    return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25)
}

private fn ch(e: u32, f: u32, g: u32): u32 {
    return (e & f) ^ ((e ^ 0xFFFFFFFF) & g)
}

private fn maj(a: u32, b: u32, c: u32): u32 {
    return (a & b) ^ (a & c) ^ (b & c)
}

private fn be32_bytes(b0: u8, b1: u8, b2: u8, b3: u8): u32 {
    val x0 = b0 as u64
    val x1 = b1 as u64
    val x2 = b2 as u64
    val x3 = b3 as u64
    return ((x0 << 24) | (x1 << 16) | (x2 << 8) | x3) as u32
}

private fn *Sha256.word_at(off: usize): u32 {
    return be32_bytes(self.buf[off], self.buf[off + 1], self.buf[off + 2], self.buf[off + 3])
}

// FIPS 180-4 section 6.2.2, one 512-bit block in buf.
private fn *Sha256.compress() {
    var w: [64]u32
    var i: usize = 0
    for i < 16 {
        w[i] = self.word_at(i * 4)
        i = i + 1
    }
    for i < 64 {
        val s0 = sigma0(w[i - 15])
        val s1 = sigma1(w[i - 2])
        w[i] = add4(s1, w[i - 7], s0, w[i - 16])
        i = i + 1
    }
    var a = self.h[0]
    var b = self.h[1]
    var c = self.h[2]
    var d = self.h[3]
    var e = self.h[4]
    var f = self.h[5]
    var g = self.h[6]
    var hh = self.h[7]
    var r: usize = 0
    for r < 64 {
        val t1 = add5(hh, big1(e), ch(e, f, g), sha_k[r], w[r])
        val t2 = add_u32(big0(a), maj(a, b, c))
        hh = g
        g = f
        f = e
        e = add_u32(d, t1)
        d = c
        c = b
        b = a
        a = add_u32(t1, t2)
        r = r + 1
    }
    self.h[0] = add_u32(self.h[0], a)
    self.h[1] = add_u32(self.h[1], b)
    self.h[2] = add_u32(self.h[2], c)
    self.h[3] = add_u32(self.h[3], d)
    self.h[4] = add_u32(self.h[4], e)
    self.h[5] = add_u32(self.h[5], f)
    self.h[6] = add_u32(self.h[6], g)
    self.h[7] = add_u32(self.h[7], hh)
}

fn *Sha256.update(data: bytes) {
    self.total = self.total + (data.len as u64)
    var i: usize = 0
    for i < data.len {
        self.buf[self.buf_len] = data.ptr[i]
        self.buf_len = self.buf_len + 1
        i = i + 1
        if self.buf_len == 64 {
            self.compress()
            self.buf_len = 0
        }
    }
}

// Pads and returns the 32-byte digest. The state is finished; do not
// update it again.
fn *Sha256.finish(): [32]u8 {
    val bits = self.total * 8
    self.buf[self.buf_len] = 0x80
    self.buf_len = self.buf_len + 1
    if self.buf_len > 56 {
        for self.buf_len < 64 {
            self.buf[self.buf_len] = 0
            self.buf_len = self.buf_len + 1
        }
        self.compress()
        self.buf_len = 0
    }
    for self.buf_len < 56 {
        self.buf[self.buf_len] = 0
        self.buf_len = self.buf_len + 1
    }
    var shift: u64 = 56
    var k: usize = 0
    for k < 8 {
        self.buf[self.buf_len] = ((bits >> shift) & 0xFF) as u8
        self.buf_len = self.buf_len + 1
        if shift >= 8 {
            shift = shift - 8
        }
        k = k + 1
    }
    self.compress()
    var out: [32]u8
    var i: usize = 0
    for i < 8 {
        val word = self.h[i]
        val base = i * 4
        out[base] = ((word >> 24) & 0xFF) as u8
        out[base + 1] = ((word >> 16) & 0xFF) as u8
        out[base + 2] = ((word >> 8) & 0xFF) as u8
        out[base + 3] = (word & 0xFF) as u8
        i = i + 1
    }
    return out
}

fn copy_text(text: str): str with (a: mem.Allocator) {
    if text.len == 0 {
        return ""
    }
    val (raw, err) = a.alloc(text.len, align(u8))
    if err != null {
        panic("out of memory")
    }
    var i: usize = 0
    for i < text.len {
        raw.ptr[i] = text.ptr[i]
        i = i + 1
    }
    return raw
}

fn free_text(text: str) with (a: mem.Allocator) {
    if text.len == 0 {
        return
    }
    var block = bytes()
    block.ptr = text.ptr as *u8
    block.len = text.len
    a.free(block)
}

private fn append_hex_byte(sb: *strbuilder.StrBuilder, b: u8) with (a: mem.Allocator) {
    val digits = "0123456789abcdef"
    val hi = (b >> 4) as usize
    val lo = (b & 0x0F) as usize
    sb.append_byte(digits.ptr[hi])
    sb.append_byte(digits.ptr[lo])
}

private fn hex_digest(dig: [32]u8): str with (a: mem.Allocator) {
    var sb = strbuilder.empty()
    var i: usize = 0
    for i < 32 {
        append_hex_byte(&sb, dig[i])
        i = i + 1
    }
    val text = copy_text(sb.str())
    sb.free()
    return text
}

// Lowercase hex SHA-256 of data: 64 characters, a new block from the
// Allocator.
fn sha256_hex(data: bytes): str with (a: mem.Allocator) {
    var s = sha256_new()
    s.update(data)
    return hex_digest(s.finish())
}

// files are sorted by name. The result is "sha256:" and 64 hex digits,
// a new block. Each file's name and bytes are only read.
fn content_hash(files: []File): str with (a: mem.Allocator) {
    var lines = strbuilder.empty()
    var i: usize = 0
    for i < files.len {
        val hex = sha256_hex(files[i].data)
        lines.append(hex)
        free_text(hex)
        lines.append(" ")
        lines.append(files[i].name)
        lines.append("\n")
        i = i + 1
    }
    var view = bytes()
    if lines.len > 0 {
        view.ptr = lines.ptr!!
        view.len = lines.len
    }
    val hex = sha256_hex(view)
    var out = strbuilder.empty()
    out.append("sha256:")
    out.append(hex)
    free_text(hex)
    lines.free()
    val text = copy_text(out.str())
    out.free()
    return text
}
