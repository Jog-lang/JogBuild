// Package src.resolve: the dependency graph. Path specs, local .jogz
// archives, and versions already in the cache. The walk is depth-first:
// gray means the module is on the stack, and the emitted order is
// dependencies first.
//
// "Same folder" is the normalized absolute path. Windows compares it
// case-insensitively. Linux and macOS compare the bytes. The current
// directory comes from fs.cwd.

import std.error as errors
import std.fs
import std.io
import std.list
import std.map
import std.mem
import std.strbuilder

import src.cache
import src.fail
import src.host
import src.manifest
import std.text

enum Source {
    Path
    Archive
    Cache
}

struct Node {
    name: str
    version: manifest.Version
    source: Source
    spec: str
    dir: str
    hash: str
    has_version: bool
    requires: list.List<str>
    chain: list.List<str>
}

struct Graph {
    root: manifest.Manifest
    root_dir: str
    nodes: list.List<Node>
}

private val color_gray: u8 = 1
private val color_done: u8 = 2

private struct Work {
    name: str
    dir: str
    spec: str
    version: manifest.Version
    man: manifest.Manifest
    chain: list.List<str>
    color: u8
    source: Source
    hash: str
    has_version: bool
}

private struct Walk {
    works: list.List<Work>
    index: map.Map<str, usize>
    order: list.List<usize>
    root_name: str
    jog_version: manifest.Version
}

fn source_name(s: Source): str {
    if s is Path {
        return "path"
    }
    if s is Archive {
        return "archive"
    }
    return "cache"
}

fn missing_cache_message(name: str, spec: str): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("module '")
    b.append(name)
    b.append("' ")
    b.append(spec)
    b.append(" is not in the cache; fetching is not available yet; require it by the path of its .jogz")
    val text = fs.copy_str(b.str())
    b.free()
    return text
}

private fn is_sep(c: u8): bool {
    return c == '/' as u8 || c == '\\' as u8
}

private fn is_letter(c: u8): bool {
    if c >= 'a' as u8 && c <= 'z' as u8 {
        return true
    }
    return c >= 'A' as u8 && c <= 'Z' as u8
}

private fn fold(c: u8): u8 {
    if c >= 'A' as u8 && c <= 'Z' as u8 {
        return c + ('a' as u8 - 'A' as u8)
    }
    return c
}

fn same_folder(a: str, b: str): bool {
    if a.len != b.len {
        return false
    }
    var i: usize = 0
    for i < a.len {
        var left = a.ptr[i]
        var right = b.ptr[i]
        if host.fold_case() {
            left = fold(left)
            right = fold(right)
        }
        if left != right {
            return false
        }
        i = i + 1
    }
    return true
}

private fn is_absolute(path: str): bool {
    if path.len >= 1 && is_sep(path.ptr[0]) {
        return true
    }
    if path.len >= 2 && path.ptr[1] == ':' as u8 && is_letter(path.ptr[0]) {
        return true
    }
    return false
}

fn normalize(path: str): str with (a: mem.Allocator) {
    var segs: list.List<str>
    var drive: str = ""
    var abs = false
    var i: usize = 0
    if path.len >= 2 && path.ptr[1] == ':' as u8 && is_letter(path.ptr[0]) {
        drive = text.slice(path, 0, 2)
        abs = true
        i = 2
        if i < path.len && is_sep(path.ptr[i]) {
            i = i + 1
        }
    } else if path.len > 0 && is_sep(path.ptr[0]) {
        abs = true
        i = 1
    }
    for i < path.len {
        if is_sep(path.ptr[i]) {
            i = i + 1
            continue
        }
        val start = i
        for i < path.len {
            if is_sep(path.ptr[i]) {
                break
            }
            i = i + 1
        }
        val seg = text.slice(path, start, i)
        if seg == "." || seg.len == 0 {
            continue
        }
        if seg == ".." {
            if segs.len > 0 && segs.get(segs.len - 1) != ".." {
                segs.pop()
            } else if !abs {
                segs.push(seg)
            }
            continue
        }
        segs.push(seg)
    }
    var b = strbuilder.empty()
    if drive.len == 2 {
        b.append(drive)
        b.append("/")
    } else if abs {
        b.append("/")
    }
    var n: usize = 0
    for n < segs.len {
        if n > 0 {
            b.append("/")
        }
        b.append(segs.get(n))
        n = n + 1
    }
    segs.free()
    val text = fs.copy_str(b.str())
    b.free()
    return text
}

fn absolute(base_dir: str, spec: str): str with (a: mem.Allocator) {
    if is_absolute(spec) {
        return normalize(spec)
    }
    val joined = fs.join(base_dir, spec)
    val norm = normalize(joined)
    fs.free_str(joined)
    return norm
}

private fn cwd(): (str, error?) with (a: mem.Allocator) {
    var (dir, ok) = fs.cwd()
    if !ok {
        return "", errors.ErrIO
    }
    return dir, null
}

private fn parent_dir(path: str): (str, bool) with (a: mem.Allocator) {
    if path.len == 0 {
        return "", false
    }
    var end = path.len
    if path.ptr[end - 1] == '/' as u8 && end > 0 {
        end = end - 1
    }
    var slash: i64 = -1
    var k: usize = 0
    for k < end {
        if path.ptr[k] == '/' as u8 {
            slash = k as i64
        }
        k = k + 1
    }
    if slash < 0 {
        return "", false
    }
    if slash == 2 && path.len >= 2 && path.ptr[1] == ':' as u8 {
        return fs.copy_str(text.slice(path, 0, 3)), true
    }
    if slash == 0 {
        return fs.copy_str("/"), true
    }
    return fs.copy_str(text.slice(path, 0, slash as usize)), true
}

/**
 * Walk from the current directory up to the first jog.mod.
 * @context a allocator for the directory path
 * @return that directory, or ErrNotFound when none exists
 */
fn module_root(): (str, error?) with (a: mem.Allocator) {
    var (dir, cerr) = cwd()
    if cerr != null {
        return "", cerr
    }
    val norm = normalize(dir)
    fs.free_str(dir)
    var current = norm
    for {
        val man = fs.join(current, "jog.mod")
        var (data, err) = fs.read_all(man)
        fs.free_str(man)
        if err == null {
            a.free(data)
            return current, null
        }
        var (up, pok) = parent_dir(current)
        fs.free_str(current)
        if !pok {
            return "", errors.ErrNotFound
        }
        current = up
    }
}

private fn manifest_path(dir: str): str with (a: mem.Allocator) {
    return fs.join(dir, "jog.mod")
}

private fn print_at(path: str, line: i64, col: i64, message: str) with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append(path)
    b.append(":")
    b.append_int(line, 10)
    b.append(":")
    b.append_int(col, 10)
    b.append(": error: ")
    b.append(message)
    io.eprintln(b.str())
    b.free()
}

// 0 is a parsed manifest, 1 means the file is missing, 2 means parse failed
// and the diagnostic is already printed.
private fn read_mod(dir: str): (manifest.Manifest, str, i32) with (a: mem.Allocator) {
    var blank: manifest.Manifest
    val path = manifest_path(dir)
    var (data, read_err) = fs.read_all(path)
    if read_err != null {
        fs.free_str(path)
        return blank, "", 1
    }
    val text_bytes: str = data
    var (m, err, pok) = manifest.parse(text_bytes)
    a.free(data)
    if !pok {
        print_at(path, err.pos.line, err.pos.col, err.message)
        fs.free_str(path)
        return blank, "", 2
    }
    return m, path, 0
}

private fn copy_chain(chain: list.List<str>, extra: str): list.List<str> with (a: mem.Allocator) {
    var out: list.List<str>
    var i: usize = 0
    for i < chain.len {
        out.push(fs.copy_str(chain.get(i)))
        i = i + 1
    }
    if extra.len > 0 {
        out.push(fs.copy_str(extra))
    }
    return out
}

private fn append_chain(b: *strbuilder.StrBuilder, names: list.List<str>, version: manifest.Version, kind: str, spec: str) with (a: mem.Allocator) {
    var i: usize = 0
    for i < names.len {
        if i > 0 {
            b.append(" -> ")
        }
        b.append(names.get(i))
        if i + 1 == names.len {
            b.append(" ")
            manifest.append_version(b, version)
            b.append(" (")
            b.append(kind)
            b.append(" ")
            b.append(spec)
            b.append(")")
        }
        i = i + 1
    }
}

private fn names_ci(a: str, b: str): bool {
    return same_folder(a, b)
}

private fn *Walk.case_clash(name: str): bool with (a: mem.Allocator) {
    if names_ci(self.root_name, name) && self.root_name != name {
        var b = strbuilder.empty()
        b.append("jog.mod: error: modules '")
        b.append(self.root_name)
        b.append("' and '")
        b.append(name)
        b.append("' differ only in case")
        io.eprintln(b.str())
        b.free()
        return true
    }
    var i: usize = 0
    for i < self.works.len {
        val w = self.works.get(i)
        if names_ci(w.name, name) && w.name != name {
            var b = strbuilder.empty()
            b.append("jog.mod: error: modules '")
            b.append(w.name)
            b.append("' and '")
            b.append(name)
            b.append("' differ only in case")
            io.eprintln(b.str())
            b.free()
            return true
        }
        i = i + 1
    }
    return false
}

private fn cycle_message(parent: list.List<str>, repeated: str): str with (a: mem.Allocator) {
    var start: usize = 0
    var found = false
    var i: usize = 0
    for i < parent.len {
        if parent.get(i) == repeated {
            start = i
            found = true
            break
        }
        i = i + 1
    }
    var b = strbuilder.empty()
    b.append("jog.mod: error: import cycle: ")
    if !found {
        start = 0
    }
    var n = start
    var any = false
    for n < parent.len {
        if any {
            b.append(" -> ")
        }
        b.append(parent.get(n))
        any = true
        n = n + 1
    }
    if any {
        b.append(" -> ")
    }
    b.append(repeated)
    val text = fs.copy_str(b.str())
    b.free()
    return text
}

private fn conflict_message(name: str, first: list.List<str>, first_ver: manifest.Version, first_kind: str, first_spec: str, second: list.List<str>, second_ver: manifest.Version, second_kind: str, second_spec: str): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog.mod: error: module '")
    b.append(name)
    b.append("' is required twice, with different sources:\n  ")
    append_chain(&b, first, first_ver, first_kind, first_spec)
    b.append("\n  ")
    append_chain(&b, second, second_ver, second_kind, second_spec)
    b.append("\na build has one version of each module")
    val out = fs.copy_str(b.str())
    b.free()
    return out
}

private fn jog_message(man: manifest.Manifest, have: manifest.Version): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog.mod: module '")
    b.append(man.module)
    b.append("' needs jog ")
    manifest.append_version(&b, man.jog)
    b.append(" or later; this is jog ")
    manifest.append_version(&b, have)
    val text = fs.copy_str(b.str())
    b.free()
    return text
}

private fn report_missing(name: str, dir: str) with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog.mod: error: cannot find module '")
    b.append(name)
    b.append("' at '")
    b.append(dir)
    b.append("'")
    io.eprintln(b.str())
    b.free()
}

// True when left's slash-normalized form sorts strictly before right's.
// Among several specs for one folder, the lock keeps the earliest, so
// the file does not depend on require order.
private fn spec_before(left: str, right: str): bool {
    var i: usize = 0
    var j: usize = 0
    for {
        if i >= left.len && j >= right.len {
            return false
        }
        if i >= left.len {
            return true
        }
        if j >= right.len {
            return false
        }
        var ca = left.ptr[i]
        var cb = right.ptr[j]
        if ca == '\\' as u8 {
            ca = '/' as u8
        }
        if cb == '\\' as u8 {
            cb = '/' as u8
        }
        if ca < cb {
            return true
        }
        if cb < ca {
            return false
        }
        i = i + 1
        j = j + 1
    }
}

private fn *Walk.check_new(dir: str, req: manifest.Require, chain: list.List<str>, source: Source, file_hash: str): bool with (a: mem.Allocator) {
    var (man, path, status) = read_mod(dir)
    if status == 1 {
        report_missing(req.module, dir)
        return false
    }
    if status != 0 {
        return false
    }
    if man.module != req.module {
        var b = strbuilder.empty()
        b.append("jog.mod: module '")
        b.append(man.module)
        b.append("' was required as '")
        b.append(req.module)
        b.append("'")
        print_at(path, man.name_line, man.name_col, b.str())
        b.free()
        fs.free_str(path)
        return false
    }
    if !man.library {
        var b = strbuilder.empty()
        b.append("jog.mod: module '")
        b.append(req.module)
        b.append("' is not a library; only a module with 'kind library' can be required")
        print_at(path, man.name_line, man.name_col, b.str())
        b.free()
        fs.free_str(path)
        return false
    }
    if man.has_jog && !manifest.accepts(man.jog, self.jog_version) {
        val msg = jog_message(man, self.jog_version)
        print_at(path, man.jog_line, man.jog_col, msg)
        fs.free_str(msg)
        fs.free_str(path)
        return false
    }
    fs.free_str(path)
    var w: Work
    w.name = fs.copy_str(req.module)
    w.dir = fs.copy_str(dir)
    w.spec = fs.copy_str(req.spec)
    w.version = manifest.copy_version(man.version)
    w.man = man
    w.chain = chain
    w.color = color_gray
    w.source = source
    w.hash = fs.copy_str(file_hash)
    w.has_version = man.has_version
    val idx = self.works.len
    self.works.push(w)
    val key = self.works.get(idx).name
    self.index.insert(key, map.fnv1a(key), idx)
    if !self.walk_requires(dir, man, chain) {
        return false
    }
    var done = self.works.get(idx)
    done.color = color_done
    self.works.set(idx, done)
    self.order.push(idx)
    return true
}

private fn *Walk.consider(req: manifest.Require, dir: str, parent: list.List<str>, source: Source, file_hash: str): bool with (a: mem.Allocator) {
    var existing: usize = 0
    if self.index.get(req.module, map.fnv1a(req.module), &existing) {
        val w = self.works.get(existing)
        if w.color == color_gray {
            val msg = cycle_message(parent, req.module)
            io.eprintln(msg)
            fs.free_str(msg)
            return false
        }
        if same_folder(w.dir, dir) {
            if spec_before(req.spec, w.spec) {
                var updated = self.works.get(existing)
                val old_spec = updated.spec
                updated.spec = fs.copy_str(req.spec)
                fs.free_str(old_spec)
                self.works.set(existing, updated)
            }
            return true
        }
        var (other, path, status) = read_mod(dir)
        if status == 1 {
            report_missing(req.module, dir)
            return false
        }
        if status != 0 {
            return false
        }
        if other.module != req.module {
            var b = strbuilder.empty()
            b.append("jog.mod: module '")
            b.append(other.module)
            b.append("' was required as '")
            b.append(req.module)
            b.append("'")
            print_at(path, other.name_line, other.name_col, b.str())
            b.free()
            fs.free_str(path)
            return false
        }
        val second = copy_chain(parent, req.module)
        val msg = conflict_message(req.module, w.chain, w.version, source_name(w.source), w.spec, second, other.version, source_name(source), req.spec)
        io.eprintln(msg)
        fs.free_str(msg)
        fs.free_str(path)
        return false
    }
    if self.case_clash(req.module) {
        return false
    }
    val chain = copy_chain(parent, req.module)
    return self.check_new(dir, req, chain, source, file_hash)
}

private fn *Walk.visit_archive(req: manifest.Require, from_dir: str, parent: list.List<str>): bool with (a: mem.Allocator) {
    val jogz = absolute(from_dir, req.spec)
    val root = cache.dir()
    if root.len == 0 {
        io.eprintln("jog-build: no cache directory; set JOG_CACHE")
        fs.free_str(jogz)
        return false
    }
    var (am, iok) = cache.install(root, jogz)
    fs.free_str(jogz)
    if iok != null {
        fs.free_str(root)
        return false
    }
    if am.m.module != req.module {
        var b = strbuilder.empty()
        b.append("jog.mod: module '")
        b.append(am.m.module)
        b.append("' was required as '")
        b.append(req.module)
        b.append("'")
        io.eprintln(b.str())
        b.free()
        cache.free_manifest(&am)
        fs.free_str(root)
        return false
    }
    val ver = manifest.version_text(am.m.version)
    val dir = cache.src_dir(root, am.m.module, ver)
    val file_hash = fs.copy_str(am.hash)
    cache.free_manifest(&am)
    fs.free_str(ver)
    fs.free_str(root)
    val ok = self.consider(req, dir, parent, Source.Archive, file_hash)
    fs.free_str(dir)
    fs.free_str(file_hash)
    return ok
}

private fn *Walk.visit_version(req: manifest.Require, parent: list.List<str>): bool with (a: mem.Allocator) {
    val root = cache.dir()
    var present = false
    if root.len > 0 {
        present = cache.has(root, req.module, req.spec)
    }
    if !present {
        val msg = missing_cache_message(req.module, req.spec)
        io.eprintln(msg)
        fs.free_str(msg)
        fs.free_str(root)
        return false
    }
    var (am, sok) = cache.stored(root, req.module, req.spec)
    if sok != null {
        io.eprint("jog-build: cannot read the cached manifest for '")
        io.eprint(req.module)
        io.eprintln("'")
        fs.free_str(root)
        return false
    }
    val dir = cache.src_dir(root, req.module, req.spec)
    val file_hash = fs.copy_str(am.hash)
    cache.free_manifest(&am)
    fs.free_str(root)
    val ok = self.consider(req, dir, parent, Source.Cache, file_hash)
    fs.free_str(dir)
    fs.free_str(file_hash)
    return ok
}

private fn *Walk.visit(req: manifest.Require, from_dir: str, parent: list.List<str>): bool with (a: mem.Allocator) {
    if text.ends_with(req.spec, ".jogz") {
        return self.visit_archive(req, from_dir, parent)
    }
    if !req.is_path {
        return self.visit_version(req, parent)
    }
    val dir = absolute(from_dir, req.spec)
    val ok = self.consider(req, dir, parent, Source.Path, "")
    fs.free_str(dir)
    return ok
}

private fn *Walk.walk_requires(dir: str, man: manifest.Manifest, chain: list.List<str>): bool with (a: mem.Allocator) {
    var i: usize = 0
    for i < man.requires.len {
        if !self.visit(man.requires.get(i), dir, chain) {
            return false
        }
        i = i + 1
    }
    return true
}

private fn node_from(w: Work): Node with (a: mem.Allocator) {
    var n: Node
    n.name = fs.copy_str(w.name)
    n.version = manifest.copy_version(w.version)
    n.source = w.source
    n.spec = fs.copy_str(w.spec)
    n.dir = fs.copy_str(w.dir)
    n.hash = fs.copy_str(w.hash)
    n.has_version = w.has_version
    var i: usize = 0
    for i < w.man.requires.len {
        n.requires.push(fs.copy_str(w.man.requires.get(i).module))
        i = i + 1
    }
    i = 0
    for i < w.chain.len {
        n.chain.push(fs.copy_str(w.chain.get(i)))
        i = i + 1
    }
    return n
}

/**
 * Build the dependency graph. A failure is already printed.
 * @param root_dir module root, relative or absolute
 * @param jog_version compiler version from version
 * @context a allocator for the graph
 * @return the graph, or ErrReported
 */
fn resolve(root_dir: str, jog_version: manifest.Version): (Graph, error?) with (a: mem.Allocator) {
    var g: Graph
    val root = prepare_root(root_dir)
    g.root_dir = root
    var (man, path, status) = read_mod(root)
    if status == 1 {
        io.eprintln("jog-build: cannot find jog.mod")
        return g, fail.ErrReported
    }
    if status != 0 {
        return g, fail.ErrReported
    }
    fs.free_str(path)
    if man.has_jog && !manifest.accepts(man.jog, jog_version) {
        val msg = jog_message(man, jog_version)
        val again = manifest_path(root)
        print_at(again, man.jog_line, man.jog_col, msg)
        fs.free_str(msg)
        fs.free_str(again)
        return g, fail.ErrReported
    }
    g.root = man
    var walk: Walk
    walk.root_name = man.module
    walk.jog_version = jog_version
    var chain: list.List<str>
    chain.push(fs.copy_str(man.module))
    if !walk.walk_requires(root, man, chain) {
        return g, fail.ErrReported
    }
    var i: usize = 0
    for i < walk.order.len {
        val idx = walk.order.get(i)
        g.nodes.push(node_from(walk.works.get(idx)))
        i = i + 1
    }
    return g, null
}

// Relative roots are joined to the current directory. The result is normalized.
private fn prepare_root(root_dir: str): str with (a: mem.Allocator) {
    if is_absolute(root_dir) {
        return normalize(root_dir)
    }
    var (c, err) = cwd()
    if err != null {
        return normalize(root_dir)
    }
    val joined = fs.join(c, root_dir)
    fs.free_str(c)
    val norm = normalize(joined)
    fs.free_str(joined)
    return norm
}

fn free(g: *Graph) with (a: mem.Allocator) {
    manifest.free(&g.root)
    fs.free_str(g.root_dir)
    var i: usize = 0
    for i < g.nodes.len {
        var n = g.nodes.get(i)
        fs.free_str(n.name)
        fs.free_str(n.spec)
        fs.free_str(n.dir)
        fs.free_str(n.hash)
        fs.free_str(n.version.major)
        fs.free_str(n.version.minor)
        fs.free_str(n.version.patch)
        fs.free_str(n.version.pre)
        var k: usize = 0
        for k < n.requires.len {
            fs.free_str(n.requires.get(k))
            k = k + 1
        }
        n.requires.free()
        k = 0
        for k < n.chain.len {
            fs.free_str(n.chain.get(k))
            k = k + 1
        }
        n.chain.free()
        i = i + 1
    }
    g.nodes.free()
}
