// Package src.resolve: the dependency graph. Path specs only. Archive
// specs are not supported yet, and a version spec is reported as missing
// from the cache. The walk is depth-first: gray means the module is on
// the stack, and the emitted order is dependencies first.
//
// "Same folder" is the normalized absolute path, compared
// case-insensitively. std.c does not bind GetCurrentDirectoryA.

import std.c
import std.fs
import std.io
import std.list
import std.map
import std.mem
import std.strbuilder

import src.cache
import src.manifest
import src.text

private extern {
    fn GetCurrentDirectoryA(cap: c.unsigned_long, buffer: *c.char): c.unsigned_long
}

enum Source {
    Path
    Archive
    Cache
}

struct Node {
    name: str
    version: manifest.Version
    source: Source
    spec: str
    dir: str
    hash: str
    requires: list.List<str>
    chain: list.List<str>
}

struct Graph {
    root: manifest.Manifest
    root_dir: str
    nodes: list.List<Node>
}

private val color_gray: u8 = 1
private val color_done: u8 = 2

private struct Work {
    name: str
    dir: str
    spec: str
    version: manifest.Version
    man: manifest.Manifest
    chain: list.List<str>
    color: u8
    source: Source
}

private struct Walk {
    works: list.List<Work>
    index: map.Map<str, usize>
    order: list.List<usize>
    root_name: str
    jog_version: manifest.Version
}

fn source_name(s: Source): str {
    if s is Path {
        return "path"
    }
    if s is Archive {
        return "archive"
    }
    return "cache"
}

fn missing_cache_message(name: str, spec: str): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("module '")
    b.append(name)
    b.append("' ")
    b.append(spec)
    b.append(" is not in the cache; fetching is not available yet; require it by the path of its .jogz")
    val text = text.copy_str(b.str())
    b.free()
    return text
}

private fn is_sep(c: u8): bool {
    return c == '/' as u8 || c == '\\' as u8
}

private fn is_letter(c: u8): bool {
    if c >= 'a' as u8 && c <= 'z' as u8 {
        return true
    }
    return c >= 'A' as u8 && c <= 'Z' as u8
}

private fn fold(c: u8): u8 {
    if c >= 'A' as u8 && c <= 'Z' as u8 {
        return c + ('a' as u8 - 'A' as u8)
    }
    return c
}

fn same_folder(a: str, b: str): bool {
    if a.len != b.len {
        return false
    }
    var i: usize = 0
    for i < a.len {
        if fold(a.ptr[i]) != fold(b.ptr[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

private fn is_absolute(path: str): bool {
    if path.len >= 1 && is_sep(path.ptr[0]) {
        return true
    }
    if path.len >= 2 && path.ptr[1] == ':' as u8 && is_letter(path.ptr[0]) {
        return true
    }
    return false
}

fn normalize(path: str): str with (a: mem.Allocator) {
    var segs: list.List<str>
    var drive: str = ""
    var abs = false
    var i: usize = 0
    if path.len >= 2 && path.ptr[1] == ':' as u8 && is_letter(path.ptr[0]) {
        drive = text.view_range(path, 0, 2)
        abs = true
        i = 2
        if i < path.len && is_sep(path.ptr[i]) {
            i = i + 1
        }
    } else if path.len > 0 && is_sep(path.ptr[0]) {
        abs = true
        i = 1
    }
    for i < path.len {
        if is_sep(path.ptr[i]) {
            i = i + 1
            continue
        }
        val start = i
        for i < path.len {
            if is_sep(path.ptr[i]) {
                break
            }
            i = i + 1
        }
        val seg = text.view_range(path, start, i)
        if seg == "." || seg.len == 0 {
            continue
        }
        if seg == ".." {
            if segs.len > 0 && segs.get(segs.len - 1) != ".." {
                segs.pop()
            } else if !abs {
                segs.push(seg)
            }
            continue
        }
        segs.push(seg)
    }
    var b = strbuilder.empty()
    if drive.len == 2 {
        b.append(drive)
        b.append("/")
    } else if abs {
        b.append("/")
    }
    var n: usize = 0
    for n < segs.len {
        if n > 0 {
            b.append("/")
        }
        b.append(segs.get(n))
        n = n + 1
    }
    segs.free()
    val text = text.copy_str(b.str())
    b.free()
    return text
}

fn absolute(base_dir: str, spec: str): str with (a: mem.Allocator) {
    if is_absolute(spec) {
        return normalize(spec)
    }
    val joined = fs.join(base_dir, spec)
    val norm = normalize(joined)
    text.free_str(joined)
    return norm
}

private fn cwd(): (str, bool) with (a: mem.Allocator) {
    var buf: [4096]u8
    val n = GetCurrentDirectoryA(4096, buf[..].ptr as *c.char)
    if n == 0 || n >= 4096 {
        return "", false
    }
    var view = bytes()
    view.ptr = buf[..].ptr
    view.len = n as usize
    return text.copy_str(view as str), true
}

private fn parent_dir(path: str): (str, bool) with (a: mem.Allocator) {
    if path.len == 0 {
        return "", false
    }
    var end = path.len
    if path.ptr[end - 1] == '/' as u8 && end > 0 {
        end = end - 1
    }
    var slash: i64 = -1
    var k: usize = 0
    for k < end {
        if path.ptr[k] == '/' as u8 {
            slash = k as i64
        }
        k = k + 1
    }
    if slash < 0 {
        return "", false
    }
    if slash == 2 && path.len >= 2 && path.ptr[1] == ':' as u8 {
        return text.copy_str(text.view_range(path, 0, 3)), true
    }
    if slash == 0 {
        return text.copy_str("/"), true
    }
    return text.copy_str(text.view_range(path, 0, slash as usize)), true
}

fn module_root(): (str, bool) with (a: mem.Allocator) {
    var (dir, ok) = cwd()
    if !ok {
        return "", false
    }
    val norm = normalize(dir)
    text.free_str(dir)
    var current = norm
    for {
        val man = fs.join(current, "jog.mod")
        var (data, found) = fs.read_all(man)
        text.free_str(man)
        if found {
            a.free(data)
            return current, true
        }
        var (up, pok) = parent_dir(current)
        text.free_str(current)
        if !pok {
            return "", false
        }
        current = up
    }
}

private fn manifest_path(dir: str): str with (a: mem.Allocator) {
    return fs.join(dir, "jog.mod")
}

private fn print_at(path: str, line: i64, col: i64, message: str) with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append(path)
    b.append(":")
    b.append_int(line, 10)
    b.append(":")
    b.append_int(col, 10)
    b.append(": error: ")
    b.append(message)
    io.eprintln(b.str())
    b.free()
}

// 0 is a parsed manifest, 1 means the file is missing, 2 means parse failed
// and the diagnostic is already printed.
private fn read_mod(dir: str): (manifest.Manifest, str, i32) with (a: mem.Allocator) {
    var blank: manifest.Manifest
    val path = manifest_path(dir)
    var (data, ok) = fs.read_all(path)
    if !ok {
        text.free_str(path)
        return blank, "", 1
    }
    val text_bytes: str = data
    var (m, err, pok) = manifest.parse(text_bytes)
    a.free(data)
    if !pok {
        print_at(path, err.pos.line, err.pos.col, err.message)
        text.free_str(path)
        return blank, "", 2
    }
    return m, path, 0
}

private fn copy_chain(chain: list.List<str>, extra: str): list.List<str> with (a: mem.Allocator) {
    var out: list.List<str>
    var i: usize = 0
    for i < chain.len {
        out.push(text.copy_str(chain.get(i)))
        i = i + 1
    }
    if extra.len > 0 {
        out.push(text.copy_str(extra))
    }
    return out
}

private fn append_chain(b: *strbuilder.StrBuilder, names: list.List<str>, version: manifest.Version, spec: str) with (a: mem.Allocator) {
    var i: usize = 0
    for i < names.len {
        if i > 0 {
            b.append(" -> ")
        }
        b.append(names.get(i))
        if i + 1 == names.len {
            b.append(" ")
            manifest.append_version(b, version)
            b.append(" (")
            b.append("path")
            b.append(" ")
            b.append(spec)
            b.append(")")
        }
        i = i + 1
    }
}

private fn names_ci(a: str, b: str): bool {
    return same_folder(a, b)
}

private fn *Walk.case_clash(name: str): bool with (a: mem.Allocator) {
    if names_ci(self.root_name, name) && self.root_name != name {
        var b = strbuilder.empty()
        b.append("jog.mod: error: modules '")
        b.append(self.root_name)
        b.append("' and '")
        b.append(name)
        b.append("' differ only in case")
        io.eprintln(b.str())
        b.free()
        return true
    }
    var i: usize = 0
    for i < self.works.len {
        val w = self.works.get(i)
        if names_ci(w.name, name) && w.name != name {
            var b = strbuilder.empty()
            b.append("jog.mod: error: modules '")
            b.append(w.name)
            b.append("' and '")
            b.append(name)
            b.append("' differ only in case")
            io.eprintln(b.str())
            b.free()
            return true
        }
        i = i + 1
    }
    return false
}

private fn cycle_message(parent: list.List<str>, repeated: str): str with (a: mem.Allocator) {
    var start: usize = 0
    var found = false
    var i: usize = 0
    for i < parent.len {
        if parent.get(i) == repeated {
            start = i
            found = true
            break
        }
        i = i + 1
    }
    var b = strbuilder.empty()
    b.append("jog.mod: error: import cycle: ")
    if !found {
        start = 0
    }
    var n = start
    var any = false
    for n < parent.len {
        if any {
            b.append(" -> ")
        }
        b.append(parent.get(n))
        any = true
        n = n + 1
    }
    if any {
        b.append(" -> ")
    }
    b.append(repeated)
    val text = text.copy_str(b.str())
    b.free()
    return text
}

private fn conflict_message(name: str, first: list.List<str>, first_ver: manifest.Version, first_spec: str, second: list.List<str>, second_ver: manifest.Version, second_spec: str): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog.mod: error: module '")
    b.append(name)
    b.append("' is required twice, with different sources:\n  ")
    append_chain(&b, first, first_ver, first_spec)
    b.append("\n  ")
    append_chain(&b, second, second_ver, second_spec)
    b.append("\na build has one version of each module")
    val text = text.copy_str(b.str())
    b.free()
    return text
}

private fn jog_message(man: manifest.Manifest, have: manifest.Version): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog.mod: module '")
    b.append(man.module)
    b.append("' needs jog ")
    manifest.append_version(&b, man.jog)
    b.append(" or later; this is jog ")
    manifest.append_version(&b, have)
    val text = text.copy_str(b.str())
    b.free()
    return text
}

private fn report_missing(name: str, dir: str) with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog.mod: error: cannot find module '")
    b.append(name)
    b.append("' at '")
    b.append(dir)
    b.append("'")
    io.eprintln(b.str())
    b.free()
}

private fn *Walk.check_new(dir: str, req: manifest.Require, chain: list.List<str>): bool with (a: mem.Allocator) {
    var (man, path, status) = read_mod(dir)
    if status == 1 {
        report_missing(req.module, dir)
        return false
    }
    if status != 0 {
        return false
    }
    if man.module != req.module {
        var b = strbuilder.empty()
        b.append("jog.mod: module '")
        b.append(man.module)
        b.append("' was required as '")
        b.append(req.module)
        b.append("'")
        print_at(path, man.name_line, man.name_col, b.str())
        b.free()
        text.free_str(path)
        return false
    }
    if !man.library {
        var b = strbuilder.empty()
        b.append("jog.mod: module '")
        b.append(req.module)
        b.append("' is not a library; only a module with 'kind library' can be required")
        print_at(path, man.name_line, man.name_col, b.str())
        b.free()
        text.free_str(path)
        return false
    }
    if man.has_jog && !manifest.accepts(man.jog, self.jog_version) {
        val msg = jog_message(man, self.jog_version)
        print_at(path, man.jog_line, man.jog_col, msg)
        text.free_str(msg)
        text.free_str(path)
        return false
    }
    text.free_str(path)
    var w: Work
    w.name = text.copy_str(req.module)
    w.dir = text.copy_str(dir)
    w.spec = text.copy_str(req.spec)
    w.version = manifest.copy_version(man.version)
    w.man = man
    w.chain = chain
    w.color = color_gray
    w.source = Source.Path
    val idx = self.works.len
    self.works.push(w)
    val key = self.works.get(idx).name
    self.index.insert(key, map.fnv1a(key), idx)
    if !self.walk_requires(dir, man, chain) {
        return false
    }
    var done = self.works.get(idx)
    done.color = color_done
    self.works.set(idx, done)
    self.order.push(idx)
    return true
}

private fn *Walk.visit(req: manifest.Require, from_dir: str, parent: list.List<str>): bool with (a: mem.Allocator) {
    if !req.is_path {
        val msg = missing_cache_message(req.module, req.spec)
        io.eprintln(msg)
        text.free_str(msg)
        return false
    }
    if text.ends_with(req.spec, ".jogz") {
        var b = strbuilder.empty()
        b.append("jog.mod: error: archive '")
        b.append(req.spec)
        b.append("' is not supported yet")
        io.eprintln(b.str())
        b.free()
        return false
    }
    val dir = absolute(from_dir, req.spec)
    var existing: usize = 0
    if self.index.get(req.module, map.fnv1a(req.module), &existing) {
        val w = self.works.get(existing)
        if w.color == color_gray {
            val msg = cycle_message(parent, req.module)
            io.eprintln(msg)
            text.free_str(msg)
            text.free_str(dir)
            return false
        }
        if same_folder(w.dir, dir) {
            text.free_str(dir)
            return true
        }
        var (other, path, status) = read_mod(dir)
        if status == 1 {
            report_missing(req.module, dir)
            text.free_str(dir)
            return false
        }
        if status != 0 {
            text.free_str(dir)
            return false
        }
        if other.module != req.module {
            var b = strbuilder.empty()
            b.append("jog.mod: module '")
            b.append(other.module)
            b.append("' was required as '")
            b.append(req.module)
            b.append("'")
            print_at(path, other.name_line, other.name_col, b.str())
            b.free()
            text.free_str(path)
            text.free_str(dir)
            return false
        }
        val second = copy_chain(parent, req.module)
        val msg = conflict_message(req.module, w.chain, w.version, w.spec, second, other.version, req.spec)
        io.eprintln(msg)
        text.free_str(msg)
        text.free_str(path)
        text.free_str(dir)
        return false
    }
    if self.case_clash(req.module) {
        text.free_str(dir)
        return false
    }
    val chain = copy_chain(parent, req.module)
    val ok = self.check_new(dir, req, chain)
    text.free_str(dir)
    return ok
}

private fn *Walk.walk_requires(dir: str, man: manifest.Manifest, chain: list.List<str>): bool with (a: mem.Allocator) {
    var i: usize = 0
    for i < man.requires.len {
        if !self.visit(man.requires.get(i), dir, chain) {
            return false
        }
        i = i + 1
    }
    return true
}

private fn node_from(w: Work): Node with (a: mem.Allocator) {
    var n: Node
    n.name = text.copy_str(w.name)
    n.version = manifest.copy_version(w.version)
    n.source = w.source
    n.spec = text.copy_str(w.spec)
    n.dir = text.copy_str(w.dir)
    var i: usize = 0
    for i < w.man.requires.len {
        n.requires.push(text.copy_str(w.man.requires.get(i).module))
        i = i + 1
    }
    i = 0
    for i < w.chain.len {
        n.chain.push(text.copy_str(w.chain.get(i)))
        i = i + 1
    }
    return n
}

fn resolve(root_dir: str, jog_version: manifest.Version): (Graph, bool) with (a: mem.Allocator) {
    var g: Graph
    val root = prepare_root(root_dir)
    g.root_dir = root
    var (man, path, status) = read_mod(root)
    if status == 1 {
        io.eprintln("jog-build: cannot find jog.mod")
        return g, false
    }
    if status != 0 {
        return g, false
    }
    text.free_str(path)
    if man.has_jog && !manifest.accepts(man.jog, jog_version) {
        val msg = jog_message(man, jog_version)
        val again = manifest_path(root)
        print_at(again, man.jog_line, man.jog_col, msg)
        text.free_str(msg)
        text.free_str(again)
        return g, false
    }
    g.root = man
    var walk: Walk
    walk.root_name = man.module
    walk.jog_version = jog_version
    var chain: list.List<str>
    chain.push(text.copy_str(man.module))
    if !walk.walk_requires(root, man, chain) {
        return g, false
    }
    var i: usize = 0
    for i < walk.order.len {
        val idx = walk.order.get(i)
        g.nodes.push(node_from(walk.works.get(idx)))
        i = i + 1
    }
    return g, true
}

// Relative roots are joined to the current directory. The result is normalized.
private fn prepare_root(root_dir: str): str with (a: mem.Allocator) {
    if is_absolute(root_dir) {
        return normalize(root_dir)
    }
    var (c, ok) = cwd()
    if !ok {
        return normalize(root_dir)
    }
    val joined = fs.join(c, root_dir)
    text.free_str(c)
    val norm = normalize(joined)
    text.free_str(joined)
    return norm
}

fn free(g: *Graph) with (a: mem.Allocator) {
    manifest.free(&g.root)
    text.free_str(g.root_dir)
    var i: usize = 0
    for i < g.nodes.len {
        var n = g.nodes.get(i)
        text.free_str(n.name)
        text.free_str(n.spec)
        text.free_str(n.dir)
        text.free_str(n.hash)
        text.free_str(n.version.major)
        text.free_str(n.version.minor)
        text.free_str(n.version.patch)
        text.free_str(n.version.pre)
        var k: usize = 0
        for k < n.requires.len {
            text.free_str(n.requires.get(k))
            k = k + 1
        }
        n.requires.free()
        k = 0
        for k < n.chain.len {
            text.free_str(n.chain.get(k))
            k = k + 1
        }
        n.chain.free()
        i = i + 1
    }
    g.nodes.free()
}
