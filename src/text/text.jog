// Byte and string helpers. std has no substring, prefix test, or owned
// copy (CTools Friction.md). copy_str allocates the exact number of live
// bytes, so free_str can release that length. An empty str is the static
// empty header and frees nothing. A view from view_range or split aliases
// its source; the caller must not free it.

import std.c
import std.list
import std.mem

fn copy_str(text: str): str with (a: mem.Allocator) {
    if text.len == 0 {
        return ""
    }
    val (raw, err) = a.alloc(text.len, align(u8))
    if err != null {
        panic("out of memory")
    }
    c.memcpy(raw.ptr as *void, text.ptr as *const void, text.len)
    return raw as str
}

fn free_str(text: str) with (a: mem.Allocator) {
    if text.len == 0 {
        return
    }
    var block = bytes()
    block.ptr = text.ptr as *u8
    block.len = text.len
    a.free(block)
}

fn starts_with(text: str, prefix: str): bool {
    if text.len < prefix.len {
        return false
    }
    var i: usize = 0
    for i < prefix.len {
        if text.ptr[i] != prefix.ptr[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn ends_with(text: str, suffix: str): bool {
    if text.len < suffix.len {
        return false
    }
    return view_range(text, text.len - suffix.len, text.len) == suffix
}

// -1 when byte does not occur.
fn index_of(text: str, byte: u8): i64 {
    var i: usize = 0
    for i < text.len {
        if text.ptr[i] == byte {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

fn view_range(text: str, start: usize, end: usize): str {
    if end < start || start > text.len {
        return ""
    }
    var stop = end
    if stop > text.len {
        stop = text.len
    }
    if stop == start {
        return ""
    }
    var view = bytes()
    view.ptr = (text.ptr + start) as *u8
    view.len = stop - start
    return view
}

// Splits on one byte. The pieces are views into text, and a separator at
// either end yields an empty piece. The list buffer is the only allocation.
fn split(text: str, sep: u8): list.List<str> with (a: mem.Allocator) {
    var parts: list.List<str>
    var start: usize = 0
    var i: usize = 0
    for i < text.len {
        if text.ptr[i] == sep {
            parts.push(view_range(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    parts.push(view_range(text, start, text.len))
    return parts
}
